{
  "name": "dotabod",
  "private": true,
  "type": "module",
  "scripts": {
    "cache:clean": "rm -rf node_modules pnpm-lock.yaml",
    "up": "pnpm update --interactive --latest",
    "nps": "doppler run -- bash services/mongodb/updatenps.sh",
    "exportnps": "doppler run -- bash services/mongodb/export.sh",
    "just": "doppler run -- bash runner.sh",
    "just-prod": "DOPPLER_CONFIG=prd doppler run -- bash runner.sh",
    "build:all": "pnpm -r run build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm run typecheck && pnpm -r run typecheck",
    "format:check": "vp fmt --config oxfmt.config.ts --check .",
    "format:fix": "vp fmt --config oxfmt.config.ts .",
    "lint": "tsx scripts/quality/verify-oxlint-baseline.ts",
    "lint:baseline:prune": "tsx scripts/quality/verify-oxlint-baseline.ts --prune",
    "lint:full": "vp lint --config oxlint.config.ts --type-aware --type-check --max-warnings=0",
    "lint:all": "pnpm run check",
    "lint:fix": "vp lint --config oxlint.config.ts --type-aware --type-check --max-warnings=0 --fix",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck:all",
    "check:fix": "pnpm run format:fix && pnpm run lint:fix",
    "quality": "pnpm run check && pnpm run knip",
    "knip": "knip",
    "prepare": "lefthook install || test ! -d .git",
    "test": "vp test run",
    "test:all": "vp test run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "10.10.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "ts-morph": "^28.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "ultracite": "7.10.8",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.5.4"
  },
  "packageManager": "pnpm@11.2.2"
}
